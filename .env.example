# Database — PostgreSQL (works locally and on serverless hosts like Vercel).
# Local dev: run Postgres and point this at it, e.g.
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_transport?schema=public"
# Production: use a hosted Postgres (Neon, Supabase, Vercel Postgres, Railway).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth — both are REQUIRED in production.
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI (optional — used for AI Transport Assistant, Document Checker,
# Service Recommendation). If unset, those features return a friendly
# "assistant unavailable" message and the rest of the app works normally.
OPENAI_API_KEY="sk-...your-key-here..."
